{
  "name": "@hubble/infrastructure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "echo 'Source-only package, no build needed'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
      "import": "./src/queue/index.ts"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "import": "./src/redis/index.ts"
    }
  },
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@hubble/config": "workspace:*",
    "@hubble/core": "workspace:*",
    "@upstash/qstash": "^2.6.0",
    "@upstash/redis": "^1.34.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@hubble/tsconfig": "workspace:*",
    "@hubble/eslint-config": "workspace:*",
    "@types/node": "^20.0.0"
  }
}
