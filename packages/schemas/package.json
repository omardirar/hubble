{
  "name": "@hubble/schemas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "echo \"Source-only package, no build needed\""
  },
  "exports": {
