{
  "extends": "@hubble/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@hubble/auth": ["../auth/src/index.ts"],
      "@hubble/auth/*": ["../auth/src/*"],
      "@hubble/chat": ["../chat/src/index.ts"],
      "@hubble/chat/*": ["../chat/src/*"],
      "@hubble/config": ["../config/src/index.ts"],
      "@hubble/config/*": ["../config/src/*"],
      "@hubble/connect": ["../connect/src/index.ts"],
      "@hubble/connect/*": ["../connect/src/*"],
      "@hubble/core": ["../core/src/index.ts"],
      "@hubble/core/*": ["../core/src/*"],
      "@hubble/db": ["../db/src/index.ts"],
      "@hubble/db/*": ["../db/src/*"],
      "@hubble/eslint-config/*": ["../eslint-config/*"],
      "@hubble/infrastructure": ["../infrastructure/src/index.ts"],
      "@hubble/infrastructure/*": ["../infrastructure/src/*"],
      "@hubble/logger": ["../logger/src/index.ts"],
      "@hubble/logger/*": ["../logger/src/*"],
      "@hubble/schemas": ["../schemas/src/index.ts"],
      "@hubble/schemas/*": ["../schemas/src/*"],
      "@hubble/tsconfig/*": ["../tsconfig/*"]
    }
  },
  "include": [
    "../auth/**/*",
    "../chat/**/*",
    "../config/**/*",
    "../connect/**/*",
    "../core/**/*",
    "../db/**/*",
    "../eslint-config/**/*",
    "../infrastructure/**/*",
    "../logger/**/*",
    "../schemas/**/*",
    "../tsconfig/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../auth"
    },
    {
      "path": "../chat"
    },
    {
      "path": "../config"
    },
    {
      "path": "../connect"
    },
    {
      "path": "../core"
    },
    {
      "path": "../db"
    },
    {
      "path": "../eslint-config"
    },
    {
      "path": "../infrastructure"
    },
    {
      "path": "../logger"
    },
    {
      "path": "../schemas"
    },
    {
      "path": "../tsconfig"
    }
  ]
}
