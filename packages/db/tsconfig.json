{
  "extends": "@hubble/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@hubble/config": ["../config/src/index.ts"],
      "@hubble/config/*": ["../config/src/*"],
      "@hubble/eslint-config/*": ["../eslint-config/*"],
      "@hubble/tsconfig/*": ["../tsconfig/*"]
    }
  },
  "include": ["../config/**/*", "../eslint-config/**/*", "../tsconfig/**/*", "src/**/*"]
}
