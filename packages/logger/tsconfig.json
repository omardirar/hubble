{
  "extends": "@hubble/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@hubble/eslint-config/*": ["../eslint-config/*"],
      "@hubble/tsconfig/*": ["../tsconfig/*"]
    }
  },
  "include": ["../eslint-config/**/*", "../tsconfig/**/*", "src/**/*"],
  "references": [
    {
      "path": "../eslint-config"
    },
    {
      "path": "../tsconfig"
    }
  ]
}
