{
  "extends": "@hubble/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "@hubble/chat": ["../chat/src/index.ts"],
      "@hubble/chat/*": ["../chat/src/*"],
      "@hubble/connect": ["../connect/src/index.ts"],
      "@hubble/connect/*": ["../connect/src/*"],
      "@hubble/core": ["../core/src/index.ts"],
      "@hubble/core/*": ["../core/src/*"],
      "@hubble/db": ["../db/src/index.ts"],
      "@hubble/db/*": ["../db/src/*"],
      "@hubble/eslint-config/*": ["../eslint-config/*"],
      "@hubble/logger": ["../logger/src/index.ts"],
      "@hubble/logger/*": ["../logger/src/*"],
      "@hubble/tsconfig/*": ["../tsconfig/*"],
      "@hubble/types": ["../types/src/index.ts"],
      "@hubble/types/*": ["../types/src/*"]
    }
  },
  "include": [
    "../chat/**/*",
    "../connect/**/*",
    "../core/**/*",
    "../db/**/*",
    "../eslint-config/**/*",
    "../logger/**/*",
    "../tsconfig/**/*",
    "../types/**/*",
    "src/**/*"
  ],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../chat"
    },
    {
      "path": "../connect"
    },
    {
      "path": "../core"
    },
    {
      "path": "../db"
    },
    {
      "path": "../eslint-config"
    },
    {
      "path": "../logger"
    },
    {
      "path": "../tsconfig"
    },
    {
      "path": "../types"
    }
  ]
}
