#!/usr/bin/env python3
"""Interactive CLI for testing the iterative agent workflow"""

import asyncio
import json
import logging
import os
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Any

from ..graph.workflow import IterativeAgentWorkflow


# Load environment variables BEFORE any other imports
def load_env_file():
    """Load environment variables from multiple sources"""
    # Try project root first
    root_dir = Path(__file__).parent.parent.parent  # Go up to project root
    env_files = [
        root_dir / ".env.local",
        root_dir / ".env",
        Path(__file__).parent / ".env.local",  # Local to agents service
    ]

    loaded_from = None
    for env_file in env_files:
        if env_file.exists():
            print(f"Loading environment from {env_file}")
            with open(env_file) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        key, value = line.split("=", 1)
                        # Remove quotes if present
                        value = value.strip("\"'")
                        os.environ[key.strip()] = value
            loaded_from = env_file
            break

    if not loaded_from:
        print("⚠ No .env file found - make sure environment variables are set")


def validate_environment():
    """Validate required environment variables"""
    required_vars = ["ANTHROPIC_API_KEY"]
    missing = [var for var in required_vars if not os.getenv(var)]

    if missing:
        print(f"❌ Missing environment variables: {', '.join(missing)}")
        return False
    return True


# Load environment variables first
load_env_file()


# Global settings - must be defined before any functions that use them
show_thinking = True
debug_mode = True  # Enable debug mode by default for better visibility
raw_mode = True  # Save raw responses to file
# Always use supervisor pattern with tools

# Set initial logger levels for debug mode
if debug_mode:
    logging.getLogger().setLevel(logging.DEBUG)
    logging.getLogger("src.mcp_client").setLevel(logging.DEBUG)
    logging.getLogger("src.config.tools").setLevel(logging.DEBUG)
    logging.getLogger("src.tools.registry").setLevel(logging.DEBUG)


class Colors:
    """ANSI color codes for terminal output"""

    HEADER = "\033[95m"
    BLUE = "\033[94m"
    CYAN = "\033[96m"
    GREEN = "\033[92m"
    WARNING = "\033[93m"
    FAIL = "\033[91m"
    ENDC = "\033[0m"
    BOLD = "\033[1m"


# Debug logging function
def debug_log(message: str, data: dict[str, Any] | None = None):
    """Log debug information when debug mode is enabled"""
    if debug_mode:
        timestamp = time.strftime("%H:%M:%S")
        print(f"{Colors.CYAN}[DEBUG {timestamp}] {message}{Colors.ENDC}")
        if data:
            for key, value in data.items():
                print(f"{Colors.CYAN}  {key}: {value}{Colors.ENDC}")


async def save_final_response(final_response: Any, raw_mode: bool = False):
    """Save final response to responses folder for review with v1.3+ schema support"""
    # Create responses directory if it doesn't exist
    responses_dir = Path(__file__).parent.parent.parent / "responses"
    responses_dir.mkdir(exist_ok=True)

    # Generate filename with timestamp and query preview
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    # Extract user message from v1.3+ schema
    # Extract user message and run ID for filename
    if hasattr(final_response, "request"):
        # FinalResponse object
        user_message = (
            final_response.request.user_message[:50]
            if final_response.request.user_message
            else "unknown"
        )
        run_id = str(final_response.run.id)[:8] if final_response.run.id else "unknown"
    else:
        # Dictionary
        if "request" in final_response and "user_message" in final_response["request"]:
            user_message = final_response["request"]["user_message"][:50]
        elif "user_message" in final_response:
            user_message = final_response["user_message"][:50]
        else:
            user_message = "unknown"

        run_id = final_response.get("run", {}).get("id", "unknown")
        if isinstance(run_id, str) and len(run_id) > 8:
            run_id = run_id[:8]

    # Clean filename
    user_message = user_message.replace(" ", "_").replace("?", "").replace("!", "")

    filename = f"{timestamp}_{run_id}_{user_message}.json"
    file_path = responses_dir / filename

    if raw_mode:
        # Save raw response (binary bytes omitted for readability)
        with open(file_path, "w", encoding="utf-8") as f:
            if hasattr(final_response, "model_dump_json"):
                # FinalResponse object - use model_dump_json for proper datetime serialization
                f.write(final_response.model_dump_json(indent=2))
            else:
                # Dictionary - use json.dump with datetime handler
                json.dump(final_response, f, indent=2, ensure_ascii=False, default=str)
        print(f"{Colors.GREEN}💾 Raw response saved to: {file_path}{Colors.ENDC}")
    else:
        # Use serialize_for_file for human-readable format
        from ..models.response_schema import FinalResponse
        from .response_builder import serialize_for_file

        try:
            if hasattr(final_response, "model_dump_json"):
                # Already a FinalResponse object
                file_data = serialize_for_file(final_response)
            else:
                # Parse as FinalResponse model
                response_model = FinalResponse.model_validate(final_response)
                file_data = serialize_for_file(response_model)

            with open(file_path, "w", encoding="utf-8") as f:
                json.dump(file_data, f, indent=2, ensure_ascii=False)
            print(f"{Colors.GREEN}💾 Response saved to: {file_path}{Colors.ENDC}")

            # Show compression info if applicable
            if hasattr(final_response, "messages") and final_response.messages.compression:
                print(
                    f"{Colors.CYAN}📦 Messages compressed with: {final_response.messages.compression}{Colors.ENDC}"
                )
            elif (
                isinstance(final_response, dict)
                and "messages" in final_response
                and final_response["messages"].get("compression")
            ):
                print(
                    f"{Colors.CYAN}📦 Messages compressed with: {final_response['messages']['compression']}{Colors.ENDC}"
                )

        except Exception as e:
            print(
                f"{Colors.WARNING}⚠ Could not serialize as v1.3+ format, saving raw: {e}{Colors.ENDC}"
            )
            with open(file_path, "w", encoding="utf-8") as f:
                if isinstance(final_response, dict):
                    json.dump(final_response, f, indent=2, ensure_ascii=False)
                else:
                    f.write(final_response.model_dump_json(indent=2))
            print(f"{Colors.GREEN}💾 Raw response saved to: {file_path}{Colors.ENDC}")


async def display_mcp_status():
    """Display MCP connection status"""
    from ..tools.registry import get_registry

    registry = get_registry()
    servers = registry.get_mcp_servers()
    stats = registry.get_tool_stats()

    print(f"\n{Colors.BOLD}🔌 MCP Server Status:{Colors.ENDC}")

    if not servers:
        print(f"{Colors.WARNING}  No MCP servers configured{Colors.ENDC}")
        print(f"{Colors.CYAN}  Using native tools only{Colors.ENDC}")
        return

    for name, config in servers.items():
        status_icon = "✅" if config.get("connected") else "❌"
        status_text = "Connected" if config.get("connected") else "Disconnected"
        color = Colors.GREEN if config.get("connected") else Colors.FAIL
        print(
            f"  {status_icon} {name}: {color}{status_text}{Colors.ENDC} ({config.get('url', 'unknown')})"
        )

    print(f"\n{Colors.CYAN}📊 Registry Stats: {stats}{Colors.ENDC}")


def print_help():
    """Print help information"""
    print(f"\n{Colors.BOLD}Available Commands:{Colors.ENDC}")
    print(f"  {Colors.GREEN}/exit{Colors.ENDC}     - Exit the CLI")
    print(f"  {Colors.GREEN}/help{Colors.ENDC}     - Show this help message")
    print(f"  {Colors.GREEN}/clear{Colors.ENDC}    - Clear the screen")
    print(f"  {Colors.GREEN}/thinking on/off{Colors.ENDC} - Toggle agent reasoning display")
    print(f"  {Colors.GREEN}/debug{Colors.ENDC}    - Toggle debug mode (shows detailed logs)")
    print(f"  {Colors.GREEN}/tools on/off{Colors.ENDC} - Toggle tool-based agent architecture")
    print(f"  {Colors.GREEN}/mcp{Colors.ENDC}      - Show MCP server status")
    print(f"  {Colors.GREEN}/tools{Colors.ENDC}    - List available tools")
    print(f"  {Colors.GREEN}/health{Colors.ENDC}   - Check MCP server health and reconnect")


# Environment variables are already loaded at the top of the file


