async def run_workflow(
    workflow: IterativeAgentWorkflow,
    query: str,
    motherduck_token: str | None = None,
    database_name: str | None = None,
    mcp_server_url: str | None = None,
    raw_mode: bool = False,
    test_mode: bool = False,
):
    """Run the workflow with the given query using v1.3+ schema"""
    try:
        print(f"{Colors.CYAN}🔄 Processing your request...{Colors.ENDC}")
        debug_log(
            "Starting workflow execution",
            {
                "query": query,
                "motherduck_token_available": bool(motherduck_token),
                "database_name": database_name,
                "mcp_server_url": mcp_server_url,
                "raw_mode": raw_mode,
            },
        )

        # Check for test mode
        if test_mode or os.getenv("AGENTS_TEST_MODE", "").lower() in ("true", "1", "yes"):
            print(
                f"{Colors.WARNING}🧪 Running in TEST MODE - no API calls will be made{Colors.ENDC}"
            )
            final_response = create_mock_response(query)
        else:
            # Lazy import to avoid circular dependencies
            try:
                from ..agents.supervisor import run_supervisor_workflow
            except ImportError as e:
                print(f"{Colors.FAIL}Failed to import supervisor: {e}{Colors.ENDC}")
                print(f"{Colors.WARNING}Falling back to mock response{Colors.ENDC}")
                final_response = create_mock_response(query)
                await save_final_response(final_response, raw_mode=raw_mode)
                return

            # Run the v1.3+ supervisor workflow
            final_response = await run_supervisor_workflow(
                user_message=query,
                conversation_id="cli-session",
                org_id="cli-org",
                user_id="cli-user",
                motherduck_token=motherduck_token,
                database_name=database_name,
                mcp_server_url=mcp_server_url,
                requested_by="user",
                policy_version="1.0",
                compress_messages=not raw_mode,  # Compress unless raw mode
            )

        # Display the response
        if final_response:
            print(f"\n{Colors.GREEN}✅ Workflow completed successfully!{Colors.ENDC}")

            # Display final response from v1.3+ schema
            if "output" in final_response and "value" in final_response["output"]:
                print(f"\n{Colors.BOLD}Final Response:{Colors.ENDC}")
                print(f"{Colors.GREEN}{final_response['output']['value']}{Colors.ENDC}")

            # Display token usage from v1.3+ schema
            if "usage" in final_response:
                usage = final_response["usage"]
                print(f"\n{Colors.CYAN}Token Usage:{Colors.ENDC}")
                print(f"  Input: {usage.get('input_tokens', 0)}")
                print(f"  Output: {usage.get('output_tokens', 0)}")
                print(f"  Reasoning: {usage.get('reasoning_tokens', 0)}")
                print(f"  Cache Write: {usage.get('cache_write_tokens', 0)}")
                print(f"  Cache Read: {usage.get('cache_read_tokens', 0)}")
                print(f"  Total: {usage.get('input_tokens', 0) + usage.get('output_tokens', 0)}")

                # Show provider-specific details
                if usage.get("details"):
                    print(f"\n{Colors.CYAN}Provider Details:{Colors.ENDC}")
                    for provider, details in usage["details"].items():
                        print(f"  {provider}: {details}")

            # Display routing information
            if "routing" in final_response:
                routing = final_response["routing"]
                print(f"\n{Colors.BLUE}Routing Decision:{Colors.ENDC}")
                print(f"  Decider: {routing.get('decider', 'unknown')}")
                print(f"  Reason: {routing.get('reason', 'unknown')}")
                print(f"  Confidence: {routing.get('confidence', 0):.2f}")
                if "strategy" in routing:
                    print(f"  Strategy: {routing['strategy']}")

            # Display MCP information
            if final_response.get("mcp"):
                mcp = final_response["mcp"]
                if mcp.get("servers"):
                    print(f"\n{Colors.BLUE}MCP Servers:{Colors.ENDC}")
                    for server in mcp["servers"]:
                        server: dict[str, Any] = server
                        print(
                            f"  • {server.get('name', 'unknown')} ({server.get('transport', 'unknown')})"
                        )
                if mcp.get("sessions"):
                    print(f"\n{Colors.BLUE}MCP Sessions:{Colors.ENDC}")
                    for session in mcp["sessions"]:
                        session: dict[str, Any] = session
                        status = "active" if not session.get("closed_at") else "closed"
                        session_id = session.get("session_id", "unknown")
                        if hasattr(session_id, "__str__"):
                            session_id = str(session_id)
                        print(f"  • {session_id[:8]}... ({status})")

            # Display events summary
            if final_response.get("events"):
                events = final_response["events"]
                print(f"\n{Colors.CYAN}Events Summary:{Colors.ENDC}")
                print(f"  Total events: {len(events)}")

                # Count by type
                event_types = {}
                for event in events:
                    event_type = event.get("type", "unknown")
                    event_types[event_type] = event_types.get(event_type, 0) + 1

                for event_type, count in event_types.items():
                    print(f"  {event_type}: {count}")

            # Save response
            await save_final_response(final_response, raw_mode=raw_mode)
        else:
            print(f"{Colors.WARNING}⚠ No final response generated{Colors.ENDC}")

    except ImportError as e:
        print(f"{Colors.FAIL}❌ Module import failed: {e}{Colors.ENDC}")
        print(f"{Colors.WARNING}⚠ Falling back to mock response{Colors.ENDC}")
        final_response = create_mock_response(query)
        await save_final_response(final_response, raw_mode=raw_mode)
    except Exception as e:
        print(f"{Colors.FAIL}❌ Workflow error: {e!s}{Colors.ENDC}")
        debug_log("Workflow error", {"error": str(e), "error_type": type(e).__name__})
        import traceback

        debug_log("Full traceback", {"traceback": traceback.format_exc()})


async def interactive_mode():
    """Run the interactive CLI mode"""
    global show_thinking, debug_mode
    raw_mode = False
    use_tools = True  # Default to using tools
    test_mode = False  # Default to normal mode

    # Get environment variables
    api_key = os.getenv("ANTHROPIC_API_KEY")
    motherduck_token = os.getenv("MOTHERDUCK_TOKEN")
    database_name = os.getenv("DATABASE_NAME", "hubble_dev")
    mcp_server_url = os.getenv("MCP_SERVER_URL")

    debug_log(
        "Starting interactive mode",
        {
            "show_thinking": show_thinking,
            "debug_mode": debug_mode,
            "api_key_available": bool(api_key),
        },
    )

    workflow = IterativeAgentWorkflow()

    # Initialize tool registry asynchronously if using tools
    if use_tools:
        debug_log("Initializing tool registry asynchronously...")
        from ..config.tools import initialize_tools_once

        try:
            # Add timeout to prevent hanging
            await asyncio.wait_for(initialize_tools_once(), timeout=30.0)
            debug_log("Tool registry initialization complete")
        except TimeoutError:
            print(f"{Colors.WARNING}⚠ Tool registry initialization timed out after 30s{Colors.ENDC}")
            print(f"{Colors.CYAN}  Continuing with limited functionality...{Colors.ENDC}")
        except Exception as e:
            print(f"{Colors.WARNING}⚠ Tool registry initialization failed: {e}{Colors.ENDC}")
            print(f"{Colors.CYAN}  Continuing with limited functionality...{Colors.ENDC}")
            debug_log("Tool registry initialization error", {"error": str(e)})

    # Display MCP status on startup
    if use_tools:
        from ..tools.registry import get_registry

        debug_log(
            "About to display MCP status",
            {"use_tools": use_tools, "registry_servers": len(get_registry().get_mcp_servers())},
        )
    await display_mcp_status()

    while True:
        try:
            user_input = input(f"{Colors.BOLD}You:{Colors.ENDC} ").strip()

            if not user_input:
                continue

            if user_input.lower() == "/exit":
                print(f"{Colors.CYAN}Goodbye! 👋{Colors.ENDC}")
                break

            if user_input.lower() == "/help":
                print_help()
                continue

            if user_input.lower() == "/clear":
                os.system("clear" if os.name != "nt" else "cls")
                continue

            if user_input.lower().startswith("/thinking"):
                parts = user_input.split()
                if len(parts) > 1:
                    if parts[1] == "on":
                        show_thinking = True
                        print(f"{Colors.GREEN}✓ Agent reasoning display enabled{Colors.ENDC}")
                    elif parts[1] == "off":
                        show_thinking = False
                        print(f"{Colors.WARNING}⚠ Agent reasoning display disabled{Colors.ENDC}")
                    else:
                        print(f"{Colors.FAIL}Usage: /thinking on|off{Colors.ENDC}")
                else:
                    status = "enabled" if show_thinking else "disabled"
                    print(f"{Colors.CYAN}Agent reasoning display: {status}{Colors.ENDC}")
                continue

            if user_input.lower().startswith("/tools"):
                parts = user_input.split()
                if len(parts) > 1:
                    if parts[1] == "on":
                        use_tools = True
                        print(f"{Colors.GREEN}✓ Tool-based architecture enabled{Colors.ENDC}")
                    elif parts[1] == "off":
                        use_tools = False
                        print(f"{Colors.WARNING}⚠ Tool-based architecture disabled{Colors.ENDC}")
                    else:
                        print(f"{Colors.FAIL}Usage: /tools on|off{Colors.ENDC}")
                else:
                    status = "enabled" if use_tools else "disabled"
                    print(f"{Colors.CYAN}Tool-based architecture: {status}{Colors.ENDC}")
                continue

            if user_input.lower() == "/debug":
                debug_mode = not debug_mode
                status = "enabled" if debug_mode else "disabled"
                print(f"{Colors.CYAN}Debug mode: {status}{Colors.ENDC}")

                # Also set Python logger level
                import logging
                if debug_mode:
                    logging.getLogger().setLevel(logging.DEBUG)
                    # Set specific loggers to debug
                    logging.getLogger("src.mcp_client").setLevel(logging.DEBUG)
                    logging.getLogger("src.config.tools").setLevel(logging.DEBUG)
                    logging.getLogger("src.tools.registry").setLevel(logging.DEBUG)
                    print(f"{Colors.CYAN}Python logger level set to DEBUG{Colors.ENDC}")
                else:
                    logging.getLogger().setLevel(logging.INFO)
                    logging.getLogger("src.mcp_client").setLevel(logging.INFO)
                    logging.getLogger("src.config.tools").setLevel(logging.INFO)
                    logging.getLogger("src.tools.registry").setLevel(logging.INFO)
                    print(f"{Colors.CYAN}Python logger level set to INFO{Colors.ENDC}")

                debug_log(
                    "Debug mode toggled", {"new_debug_mode": debug_mode, "user_input": user_input}
                )
                continue

            if user_input.lower().startswith("/raw"):
                parts = user_input.split()
                if len(parts) > 1:
                    if parts[1] == "on":
                        raw_mode = True
                        print(
                            f"{Colors.GREEN}✓ Raw mode enabled (no compression, binary bytes omitted){Colors.ENDC}"
                        )
                    elif parts[1] == "off":
                        raw_mode = False
                        print(
                            f"{Colors.WARNING}⚠ Raw mode disabled (compression enabled){Colors.ENDC}"
                        )
                    else:
                        print(f"{Colors.FAIL}Usage: /raw on|off{Colors.ENDC}")
                else:
                    status = "enabled" if raw_mode else "disabled"
                    print(f"{Colors.CYAN}Raw mode: {status}{Colors.ENDC}")
                continue

            if user_input.lower().startswith("/test"):
                parts = user_input.split()
                if len(parts) > 1:
                    if parts[1] == "on":
                        test_mode = True
                        print(
                            f"{Colors.GREEN}✓ Test mode enabled (no API calls, mock responses){Colors.ENDC}"
                        )
                    elif parts[1] == "off":
                        test_mode = False
                        print(f"{Colors.WARNING}⚠ Test mode disabled (real API calls){Colors.ENDC}")
                    else:
                        print(f"{Colors.FAIL}Usage: /test on|off{Colors.ENDC}")
                else:
                    status = "enabled" if test_mode else "disabled"
                    print(f"{Colors.CYAN}Test mode: {status}{Colors.ENDC}")
                continue

            if user_input.lower() == "/mcp":
                await display_mcp_status()
                continue

            if user_input.lower() == "/tools":
                from ..tools.registry import get_registry

                registry = get_registry()
                tools = registry.list_tools()

                print(f"\n{Colors.BOLD}🔧 Available Tools ({len(tools)}):{Colors.ENDC}")

                # Group by source
                native_tools = [t for t in tools if t.source == "native"]
                mcp_tools = [t for t in tools if t.source == "mcp"]

                if native_tools:
                    print(f"\n{Colors.GREEN}Native Tools:{Colors.ENDC}")
                    for tool in native_tools:
                        print(f"  • {tool.name}: {tool.description}")

                if mcp_tools:
                    print(f"\n{Colors.BLUE}MCP Tools:{Colors.ENDC}")
                    for tool in mcp_tools:
                        server = tool.mcp_server or "unknown"
                        print(f"  • {tool.name} ({server}): {tool.description}")
                continue

            if user_input.lower() == "/health":
                print(f"\n{Colors.BOLD}🏥 Running MCP Health Check...{Colors.ENDC}")

                from ..config.tools import refresh_mcp_connections

                # Attempt to reconnect failed servers
                await refresh_mcp_connections()

                # Display updated status
                await display_mcp_status()
                continue

            # Execute workflow
            debug_log(
                "Executing workflow for user input",
                {
                    "user_input": user_input,
                    "motherduck_token_available": bool(motherduck_token),
                    "database_name": database_name,
                    "mcp_server_url": mcp_server_url,
                },
            )

            await run_workflow(
                workflow,
                user_input,
                motherduck_token=motherduck_token,
                database_name=database_name,
                mcp_server_url=mcp_server_url,
                raw_mode=raw_mode,
                test_mode=test_mode,
            )

            print()  # Add spacing

        except EOFError:
            print(f"{Colors.WARNING}EOF detected - exiting CLI{Colors.ENDC}")
            break
        except KeyboardInterrupt:
            print(f"\n{Colors.CYAN}Goodbye! 👋{Colors.ENDC}")
            break
        except Exception as e:
            debug_log(
                "Unexpected error in interactive mode",
                {"error_type": type(e).__name__, "error": str(e)},
            )
            print(f"{Colors.FAIL}Unexpected error: {e}{Colors.ENDC}")


async def main():
    """Main entry point"""
    print(f"{Colors.HEADER}╔════════════════════════════════════════════════════════╗{Colors.ENDC}")
    print(
        f"{Colors.HEADER}║     Hubble Supervisor Agent Workflow CLI                ║{Colors.ENDC}"
    )
    print(f"{Colors.HEADER}╚════════════════════════════════════════════════════════╝{Colors.ENDC}")

    # Validate environment variables
    if not validate_environment():
        sys.exit(1)

    api_key = os.getenv("ANTHROPIC_API_KEY")
    debug_log("API key found", {"api_key_length": len(api_key) if api_key else 0})

    # Check if MotherDuck integration is enabled
    motherduck_token = os.getenv("MOTHERDUCK_TOKEN")
    if motherduck_token:
        print(f"{Colors.GREEN}✓ MotherDuck integration enabled{Colors.ENDC}")
    else:
        print(
            f"{Colors.WARNING}⚠ MotherDuck integration disabled (MOTHERDUCK_TOKEN not set){Colors.ENDC}"
        )

    print("Commands:")
    print("  /exit     - Exit the CLI")
    print("  /help     - Show this help message")
    print("  /clear    - Clear the screen")
    print("  /thinking on/off - Toggle agent reasoning display")
    print("  /debug    - Toggle debug mode (shows detailed logs)")
    print("  /tools on/off - Toggle tool-based agent architecture")
    print("  /mcp      - Show MCP server status")
    print("  /tools    - List available tools")
    print("  /health   - Check MCP server health and reconnect")
    print("  /raw on/off - Toggle raw mode (no compression, binary bytes omitted)")
    print("  /test on/off - Toggle test mode (no API calls, mock responses)")

    await interactive_mode()


if __name__ == "__main__":
    asyncio.run(main())
