# API Keys
ANTHROPIC_API_KEY=your_key_here

# Service URLs
MCP_SERVER_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# ===== AUTHENTICATION =====
# Clerk JWT (Production)
CLERK_JWKS_URL=https://clerk.your-domain.com/.well-known/jwks.json
CLERK_AUDIENCE=hubble-agents
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_ENABLED=true  # Set to false to use HMAC fallback

# Legacy HMAC Auth (Fallback/Development)
SERVICE_AUTH_SECRET=your-256-bit-secret-generate-with-openssl-rand-hex-32

# ===== SUPABASE =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ===== REDIS (Optional - for rate limiting) =====
REDIS_URL=redis://localhost:6379/0

# ===== ENVIRONMENT =====
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== CONTENT SANITIZATION =====
REDACTION_POLICY=strict  # none | permissive | strict

# ===== RATE LIMITING =====
MAX_REQUESTS_PER_MINUTE=100
MAX_CONCURRENT_RUNS_PER_ORG=5
