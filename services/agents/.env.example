# Core runtime configuration (required)
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_openai_key_here
JWT_SECRET=your-64-character-random-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
DASHBOARD_URL=http://localhost:3000

# Supabase persistence (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=agent-artifacts

# Optional OpenTelemetry / SigNoz export
OTEL_EXPORTER_OTLP_ENDPOINT=
SIGNOZ_INGESTION_KEY=
OTEL_SERVICE_NAME=h10s-agents

# Optional JWT claim validation
JWT_AUDIENCE=
JWT_ISSUER=

# Optional MotherDuck (Model Context Protocol)
MCP_MOTHERDUCK_URL=http://127.0.0.1:8001
MOTHERDUCK_TOKEN=
DATABASE_NAME=hubble_dev
