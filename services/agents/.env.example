# Core runtime configuration (required)
ANTHROPIC_API_KEY=your_key_here
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase persistence (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Pool Configuration
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_INACTIVE_LIFETIME=300.0

# Clerk Authentication (required for API)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_ISSUER=https://clerk.your-app.com
CLERK_AUDIENCE=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# API Configuration
MAX_REQUEST_BODY_SIZE=1000000
MAX_JSON_PAYLOAD_SIZE=500000

# Optional OpenTelemetry / SigNoz export
OTEL_EXPORTER_OTLP_ENDPOINT=
SIGNOZ_INGESTION_KEY=
OTEL_SERVICE_NAME=h10s-agents

# Optional JWT claim validation
JWT_AUDIENCE=
JWT_ISSUER=

# Optional MotherDuck (Model Context Protocol)
MCP_MOTHERDUCK_URL=http://127.0.0.1:8001
MOTHERDUCK_TOKEN=
DATABASE_NAME=hubble_dev
