# Core runtime configuration
ANTHROPIC_API_KEY=your_key_here
SERVICE_AUTH_SECRET=your-256-bit-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
DASHBOARD_URL=http://localhost:3000

# Supabase (analytics + persistence)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_TIMEOUT=10

# Optional Model Context Protocol (MotherDuck)
MCP_MOTHERDUCK_URL=http://127.0.0.1:8001
MOTHERDUCK_TOKEN=optional-motherduck-token
DATABASE_NAME=hubble_dev

# Authentication (Clerk - optional for production deployments)
CLERK_JWKS_URL=https://clerk.your-domain.com/.well-known/jwks.json
CLERK_AUDIENCE=hubble-agents
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_ENABLED=true

# Rate limiting (in-memory defaults)
MAX_REQUESTS_PER_MINUTE=100
