{
  "$defs": {
    "AgentConfig": {
      "description": "Agent configuration",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelConfig"
        },
        "model_settings": {
          "$ref": "#/$defs/ModelSettings"
        }
      },
      "required": ["name", "role", "model", "model_settings"],
      "title": "AgentConfig",
      "type": "object"
    },
    "ConversationContext": {
      "description": "Conversation context identifiers",
      "properties": {
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "org_id": {
          "title": "Org Id",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": ["conversation_id", "org_id", "user_id"],
      "title": "ConversationContext",
      "type": "object"
    },
    "ErrorInfo": {
      "description": "Error information for failed events",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "provider_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Code"
        }
      },
      "required": ["code", "message"],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EventData": {
      "description": "Flexible event data with provider provenance",
      "properties": {
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "provider_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Response Id"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "provider_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Uri"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "tool_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Kind"
        },
        "tool_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "request": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request"
        },
        "response": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "result_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Kind"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "total_events": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Events"
        }
      },
      "title": "EventData",
      "type": "object"
    },
    "EventRecord": {
      "description": "Event record with full provider metadata",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "source": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source",
          "type": "object"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "data": {
          "$ref": "#/$defs/EventData"
        }
      },
      "required": ["id", "ts", "source", "type", "data"],
      "title": "EventRecord",
      "type": "object"
    },
    "EventType": {
      "description": "Event types including success and failure/cancellation",
      "enum": [
        "workflow_start",
        "agent_run_started",
        "thinking_completed",
        "text_completed",
        "tool_call_completed",
        "mcp_request_completed",
        "agent_run_completed",
        "workflow_complete",
        "agent_run_failed",
        "tool_call_failed",
        "mcp_request_failed",
        "workflow_cancelled",
        "workflow_timed_out"
      ],
      "title": "EventType",
      "type": "string"
    },
    "LastModelResponse": {
      "description": "Last model response metadata",
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "provider_name": {
          "title": "Provider Name",
          "type": "string"
        },
        "finish_reason": {
          "title": "Finish Reason",
          "type": "string"
        },
        "provider_response_id": {
          "title": "Provider Response Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageDetails"
        }
      },
      "required": [
        "timestamp",
        "model_name",
        "provider_name",
        "finish_reason",
        "provider_response_id",
        "usage"
      ],
      "title": "LastModelResponse",
      "type": "object"
    },
    "MCPInfo": {
      "description": "MCP information",
      "properties": {
        "servers": {
          "items": {
            "$ref": "#/$defs/MCPServer"
          },
          "title": "Servers",
          "type": "array"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/MCPSession"
          },
          "title": "Sessions",
          "type": "array"
        }
      },
      "required": ["servers", "sessions"],
      "title": "MCPInfo",
      "type": "object"
    },
    "MCPServer": {
      "description": "MCP server information",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "transport": {
          "title": "Transport",
          "type": "string"
        },
        "protocol_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Version"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "tool_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Schema Version"
        }
      },
      "required": ["name", "version", "transport", "tools"],
      "title": "MCPServer",
      "type": "object"
    },
    "MCPSession": {
      "description": "MCP session with protocol tracking",
      "properties": {
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "server": {
          "title": "Server",
          "type": "string"
        },
        "transport": {
          "title": "Transport",
          "type": "string"
        },
        "protocol_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Version"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "closed_at": {
          "format": "date-time",
          "title": "Closed At",
          "type": "string"
        },
        "sequence_id_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Id Start"
        },
        "sequence_id_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Id End"
        }
      },
      "required": ["session_id", "server", "transport", "opened_at", "closed_at"],
      "title": "MCPSession",
      "type": "object"
    },
    "MessagesEnvelope": {
      "description": "Messages envelope with bytes storage",
      "properties": {
        "format": {
          "default": "pydantic_ai.messages",
          "title": "Format",
          "type": "string"
        },
        "encoding": {
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "scope": {
          "default": "new_run_only",
          "title": "Scope",
          "type": "string"
        },
        "compression": {
          "anyOf": [
            {
              "const": "zstd",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compression"
        },
        "json": {
          "format": "binary",
          "title": "Json",
          "type": "string"
        }
      },
      "required": ["json"],
      "title": "MessagesEnvelope",
      "type": "object"
    },
    "ModelConfig": {
      "description": "Model configuration",
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": ["provider", "name"],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelSettings": {
      "description": "Model settings including thinking budget",
      "properties": {
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "title": "Max Tokens",
          "type": "integer"
        },
        "top_p": {
          "title": "Top P",
          "type": "number"
        },
        "thinking": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        }
      },
      "required": ["temperature", "max_tokens", "top_p"],
      "title": "ModelSettings",
      "type": "object"
    },
    "OutputResult": {
      "description": "Output result",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": ["type", "value"],
      "title": "OutputResult",
      "type": "object"
    },
    "Policy": {
      "description": "Policy configuration for compliance",
      "properties": {
        "thinking_visibility": {
          "default": "full",
          "enum": ["full", "hidden"],
          "title": "Thinking Visibility",
          "type": "string"
        },
        "pii_filter": {
          "default": false,
          "title": "Pii Filter",
          "type": "boolean"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "RequestInfo": {
      "description": "Request information with trigger source",
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "user_message": {
          "title": "User Message",
          "type": "string"
        },
        "requested_by": {
          "anyOf": [
            {
              "enum": ["user", "system", "automation"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "user",
          "title": "Requested By"
        }
      },
      "required": ["timestamp", "user_message"],
      "title": "RequestInfo",
      "type": "object"
    },
    "RoutingCandidate": {
      "description": "Routing candidate for analytics",
      "properties": {
        "type": {
          "enum": ["agent", "tool", "mcp_tool"],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        }
      },
      "required": ["type", "target", "score", "eligible"],
      "title": "RoutingCandidate",
      "type": "object"
    },
    "RoutingDecision": {
      "description": "Routing decision with analytics",
      "properties": {
        "decider": {
          "title": "Decider",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "strategy": {
          "anyOf": [
            {
              "enum": ["rule_based", "prompt_router", "tool_router_llm", "hybrid"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "candidates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RoutingCandidate"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates"
        }
      },
      "required": ["decider", "reason", "confidence"],
      "title": "RoutingDecision",
      "type": "object"
    },
    "RunInfo": {
      "description": "Run information with tracing support",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "retry_of": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "title": "Attempt"
        },
        "status": {
          "enum": ["succeeded", "failed", "cancelled", "timed_out"],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowConfig"
        }
      },
      "required": ["id", "status", "started_at", "completed_at", "workflow"],
      "title": "RunInfo",
      "type": "object"
    },
    "RunUsage": {
      "description": "Run-level usage extending UsageDetails",
      "properties": {
        "requests": {
          "default": 0,
          "title": "Requests",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "input_audio_tokens": {
          "default": 0,
          "title": "Input Audio Tokens",
          "type": "integer"
        },
        "cache_audio_read_tokens": {
          "default": 0,
          "title": "Cache Audio Read Tokens",
          "type": "integer"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "title": "RunUsage",
      "type": "object"
    },
    "UsageDetails": {
      "description": "Usage details with separated token types",
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "input_audio_tokens": {
          "default": 0,
          "title": "Input Audio Tokens",
          "type": "integer"
        },
        "cache_audio_read_tokens": {
          "default": 0,
          "title": "Cache Audio Read Tokens",
          "type": "integer"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "title": "UsageDetails",
      "type": "object"
    },
    "WorkflowConfig": {
      "description": "Workflow configuration",
      "properties": {
        "type": {
          "enum": ["single_agent", "multi_agent"],
          "title": "Type",
          "type": "string"
        },
        "supervisor_agent": {
          "title": "Supervisor Agent",
          "type": "string"
        },
        "sub_agents": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sub Agents",
          "type": "array"
        }
      },
      "required": ["type", "supervisor_agent", "sub_agents"],
      "title": "WorkflowConfig",
      "type": "object"
    }
  },
  "description": "Final response schema v1.3+",
  "properties": {
    "schema_version": {
      "const": "1.3",
      "default": "1.3",
