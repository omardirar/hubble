{
  "include": ["services", "tests/python"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git",
    "**/.pytest_cache",
    "**/.next",
    "**/dist",
    "**/build",
    "**/.turbo",
    "**/.venv"
  ],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "warning",
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard"
}
