{
  "name": "hubble",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "moon run dashboard:dev",
    "build": "moon run :build",
    "typecheck": "moon run :typecheck",
    "lint": "moon run :lint",
    "format": "moon run :format",
    "format:check": "moon run :format-check",
    "test": "moon run :test",
    "sync": "moon sync",
    "commit": "cz",
    "inspector": "npx @modelcontextprotocol/inspector --port 6274"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@hubble/eslint-config": "workspace:*",
    "@hubble/prettier-config": "workspace:*",
    "@moonrepo/cli": "^1.41.4",
    "@types/node": "^20.19.15",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "cz-emoji": "^1.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "prettier": "@hubble/prettier-config",
  "engines": {
    "node": "20.19.0",
    "pnpm": ">=9"
  }
}
