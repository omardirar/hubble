{
  "name": "hubble",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "commit": "cz",
    "docker:build": "pnpm --filter @hubble/motherduck docker:build",
    "mcp:dev:motherduck": "cd mcp/servers/motherduck && uv run python -m server --transport stream --port 9001 --saas-mode",
    "mcp:inspector:motherduck": "npx @modelcontextprotocol/inspector --port 6274 --config ./mcp/servers/inspector-config.json --server motherduck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@hubble/eslint-config": "workspace:*",
    "@hubble/prettier-config": "workspace:*",
    "@types/node": "^20.19.15",
    "commitizen": "^4.3.1",
    "cz-emoji": "^1.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "prettier": "@hubble/prettier-config",
  "engines": {
    "node": ">=20.10 <25",
    "pnpm": ">=9"
  }
}
