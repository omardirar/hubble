{
  "name": "hubble",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "moon run dashboard:dev",
    "build": "moon run :build",
    "typecheck": "moon run :typecheck",
    "lint": "moon run :lint",
    "test": "moon run :test",
    "test:python": "moon run tests-python:test",
    "test:python:unit": "moon run tests-python:test-unit",
    "test:python:integration": "moon run tests-python:test-integration",
    "test:python:coverage": "moon run tests-python:test-coverage",
    "test:performance": "k6 run tests/performance/k6-chat-smoke.js",
    "format": "moon run :format",
    "format:check": "moon run :format-check",
    "commit": "cz",
    "sync": "moon sync",
    "inspector": "npx @modelcontextprotocol/inspector --port 6274",
    "inspector:motherduck": "npx @modelcontextprotocol/inspector --port 6274 --url http://localhost:8001",
    "inspector:dice": "npx @modelcontextprotocol/inspector --port 6275 --url http://localhost:8002",
    "chat": "concurrently \"moon run motherduck:dev\" \"moon run agents:dev\"",
    "dev:dashboard": "moon run dashboard:dev",
    "lint:dashboard": "moon run dashboard:lint",
    "format:dashboard": "moon run dashboard:format",
    "format:check:dashboard": "moon run dashboard:format-check",
    "typecheck:dashboard": "moon run dashboard:typecheck",
    "test:dashboard": "moon run dashboard:test",
    "dev:mcp": "concurrently \"moon run motherduck:dev\" \"moon run dice-roll:dev\"",
    "lint:mcp": "moon run motherduck:lint dice-roll:lint",
    "format:mcp": "moon run motherduck:format dice-roll:format",
    "format:check:mcp": "moon run motherduck:format-check dice-roll:format-check",
    "typecheck:mcp": "moon run motherduck:typecheck dice-roll:typecheck",
    "dev:agents": "moon run agents:dev",
    "lint:agents": "moon run agents:lint",
    "format:agents": "moon run agents:format",
    "format:check:agents": "moon run agents:format-check",
    "typecheck:agents": "moon run agents:typecheck",
    "test:agents": "moon run tests-python:test",
    "cli:agents": "moon run agents:dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@hubble/eslint-config": "workspace:*",
    "@hubble/prettier-config": "workspace:*",
    "@moonrepo/cli": "^1.41.4",
    "@types/node": "^20.19.15",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "cz-emoji": "^1.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "prettier": "@hubble/prettier-config",
  "engines": {
    "node": "20.19.0",
    "pnpm": ">=9"
  }
}
