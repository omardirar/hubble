{
  "name": "hubble",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "commit": "cz"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.3.0",
    "commitizen": "^4.3.0",
    "cz-emoji": "^1.3.1",
    "@changesets/cli": "^2.27.0",
    "@hubble/eslint-config": "workspace:*",
    "@hubble/prettier-config": "workspace:*"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "prettier": "@hubble/prettier-config",
  "engines": {
    "node": ">=20.10 <25",
    "pnpm": ">=9"
  }
}
