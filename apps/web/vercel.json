{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "relatedProjects": ["hubble-api"],
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://hubble-api.vercel.app/api/v1/$1"
    }
  ]
}
