{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "functions": {
    "src/app/api/v1/chat/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/connect/stream/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
