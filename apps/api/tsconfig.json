{
  "extends": "../../packages/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "composite": true,
    "baseUrl": ".",
    "rootDirs": ["./src", "../../packages/workflows/src"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@hubble/workflows": ["../../packages/workflows/src/index.ts"],
      "@hubble/workflows/*": ["../../packages/workflows/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/workflows/src/**/*"],
  "references": [{ "path": "../../packages/workflows" }]
}
