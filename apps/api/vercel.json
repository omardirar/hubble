{
  "version": 1,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/v1/chat",
      "dest": "/api/v1/chat"
    },
    {
      "src": "/v1/chat/conversations",
      "dest": "/api/v1/chat/conversations"
    },
    {
      "src": "/v1/chat/conversations/([^/]+)",
      "dest": "/api/v1/chat/conversations/$1"
    },
    {
      "src": "/v1/chat/messages/([^/]+)",
      "dest": "/api/v1/chat/messages/$1"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
